{
  "name": "@vexsign/cloud-signing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "worker": "node dist/src/worker.js",
    "migrate": "node dist/src/migrate.js",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "contracts": "tsx src/openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/lib-storage": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "bullmq": "^5.58.5",
    "fastify": "^5.8.0",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
