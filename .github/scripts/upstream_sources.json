  "skip_paths": [
    "**/*.xcodeproj/**",
    "**/*.xcworkspace/**",
    "**/xcshareddata/**",
    ".github/**",
    ".gitmodules",
    ".gitignore",
    "**/*.md",
    "LICENSE*",
    "Images/**",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.svg",
    "app-repo.json",
    "repos.json",
    "Makefile",
    "**/Package.resolved",
    "**/*.lproj/**",
    "Zsign",
    "Zsign/**",
    "IDeviceKit",
    "IDeviceKit/**",
    "IDeviceKitten",
    "IDeviceKitten/**",
    "idevice",
    "idevice/**"
  ],
  "manual_paths": [
    "**/Localizable.xcstrings",
    "**/*.xcstrings",
    "**/Assets.xcassets/**"
  ],
  "ignore_commit_patterns": [
    "^Merge (branch|pull request|remote-tracking)",
    "^Merge .* into ",
    "^(chore|ci|docs|style|test|build)(\\(.*\\))?!?:",
    "^(Bump|bump) ",
    "^Update (README|readme|LICENSE|FUNDING|CONTRIBUTING)",
    "^Create (FUNDING|CODEOWNERS|dependabot)",
    "^(Localiz|Translat|New translations|Crowdin)",
    "^Revert ",
    "\\[skip ci\\]",
    "^Release v?[0-9]",
    "^v?[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
    "^(Initial commit|initial commit)$"
  ],
  "feature_keywords": [
    "add",
    "added",
    "adds",
    "new",
    "support",
    "supports",
    "implement",
    "implemented",
