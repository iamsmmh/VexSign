{
  "_comment": "Upstream projects scanned by the 'Upstream feature radar' workflow and used by the 'Upstream merge kit'. Edit freely: add/remove sources, fix a repo that moved, or extend the path maps. Keys must be lowercase [a-z0-9-]. Parents must be listed before their forks so a commit that exists in both is attributed to the original.",
  "version": 1,
  "labels": {
    "radar": "upstream-radar",
    "prepare": "prepare-merge"
  },
  "radar": {
    "since_days": 30,
    "max_commits_per_source": 120,
    "max_candidates_per_source": 25,
    "max_detail_lookups_per_source": 40,
    "issue_body_limit": 60000
  },
